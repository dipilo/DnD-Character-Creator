{
  "name": "dnd-character-creator-workspace",
  "private": true,
  "workspaces": [
    "app",
    "server"
  ],
  "scripts": {
    "setup": "npm install",
    "dev": "npm run dev --workspace app",
    "start": "npm run dev --workspace app",
    "build": "npm run build --workspace app",
    "lint": "npm run lint --workspace app",
    "preview": "npm run preview --workspace app",
    "server": "npm run start --workspace server",
    "test:server": "node server/test/smoke.mjs",
    "test:server:record": "node server/test/smoke.mjs --write",
    "test:characters": "node server/test/characterRoundTrip.mjs",
    "test:scheduler": "node server/test/schedulerFlow.mjs",
    "test:availability": "node server/test/availabilityParsing.mjs",
    "test:sheet-intake": "node server/test/sheetIntake.mjs",
    "import:source": "node scripts/import-source.mjs --",
    "import:5etools": "node scripts/import-5etools.mjs",
    "generate:free-core": "node scripts/generate-free-core-sources.mjs"
  },
  "devDependencies": {
    "febdnddata": "^1.0.0-09f6c01"
  }
}
